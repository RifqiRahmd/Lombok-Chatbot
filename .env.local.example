# Salin file ini menjadi .env.local dan isi nilainya

# Groq API Key (dapatkan di https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Direct Database URL — used for raw SQL queries
# Project Settings → Database → Connection string → URI (use Transaction mode port 6543 or Session mode port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
